# Optional Cloudflare R2 / S3 for video storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=youtube-shorts-pool
R2_PUBLIC_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-to-a-random-string
