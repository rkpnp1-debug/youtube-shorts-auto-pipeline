# ===========================================
# REQUIRED
# ===========================================

# OpenAI (or any compatible provider)
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional

# YouTube Data API v3
# Get these from https://console.cloud.google.com
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===========================================
# VIDEO SOURCE (pick videos from your PC)
# ===========================================

# Full path to the folder that contains your videos.
# On Windows this is usually your Downloads folder.
#
# Examples:
#   VIDEO_POOL_PATH=C:\\Users\\YourName\\Downloads
#   VIDEO_POOL_PATH=C:\\Users\\YourName\\Videos\\Shorts
#
# If you leave it empty on Windows it defaults to %USERPROFILE%\\Downloads
VIDEO_POOL_PATH=C:\\Users\\YourName\\Downloads

# ===========================================
# OPTIONAL
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me-to-a-random-string
